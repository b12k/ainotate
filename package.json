{
  "name": "ainotate",
  "version": "0.1.0",
  "description": "Analyze @ai markers and report AI-attributed lines of code.",
  "keywords": [
    "ai",
    "cli",
    "code-analysis",
    "lines-of-code"
  ],
  "homepage": "https://github.com/b12k/ainotate#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b12k/ainotate.git"
  },
  "bin": {
    "ainotate": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "test": "rstest run",
    "test:watch": "rstest",
    "check": "run-p check:*",
    "check:lint": "oxlint . --deny-warnings",
    "check:format": "oxfmt --check",
    "check:types": "tsc --noEmit",
    "fix": "run-p fix:*",
    "fix:format": "oxfmt --write",
    "fix:lint": "oxlint . --fix",
    "deps:check": "ncu -e 1",
    "deps:update": "ncu -du --doctorInstall \"pnpm install\" --doctorTest \"pnpm deps:doctor\"",
    "deps:doctor": "pnpm test && pnpm build"
  },
  "dependencies": {
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "cosmiconfig": "9.0.2",
    "globby": "16.2.2",
    "isbinaryfile": "6.0.0",
    "p-map": "7.0.6",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@rslib/core": "0.23.2",
    "@rstest/core": "0.11.5",
    "@types/node": "26.1.2",
    "npm-check-updates": "23.0.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
